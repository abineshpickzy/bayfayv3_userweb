<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />
    <script type="text/javascript" src="https://checkout.razorpay.com/v1/razorpay.js"></script>
    <link rel="icon" href="/favicon.ico" id="defaultFavIcon" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="manifest" href="/manifest.json" />
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBHK4QeuEk8smdq4CQlpdDilsTxBtlwpNI&libraries=places"></script>
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=UA-170078099-1"
    ></script>
    <script>
      function gtag() {
        dataLayer.push(arguments);
      }
      (window.dataLayer = window.dataLayer || []),
        gtag("js", new Date()),
        gtag("config", "UA-170078099-1");
    </script>
    <title>
      <%= title %>
    </title>
    <meta
      name="title"
      content="<%= title %>"
      data-react-helmet="true"
    />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="<%= web_url %>">
    <link rel="amphtml" href="<%= web_url %>">

    <meta name="og_site_name" property="og:site_name" content="bayfay.com" />
    <meta
      name="og_title"
      property="og:title"
      content="<%= title %>"
    />
    <meta name="description" content="<%= description %>" />
    <meta name="keywords" property="keywords" content="<%= keywords %>" />      
    <meta property="og:type" content="website" />
    <meta
      property="og:description"
      content="<%= description %>"
    />
    <meta name="og_url" property="og:url" content="<%= web_url %>" />
    <meta
      property="og:image"
      content="<%= icon_url.replace('&amp;','&') %>"
    />
    <link
      rel="icon"
      sizes="192x192"
      href="https://www.bayfay.com/icons/images/icon-192x192.png">
    <link
      rel="apple-touch-icon"
      sizes="192x192"
      href="https://www.bayfay.com/icons/images/icon-192x192.png" >
    <meta name="msapplication-TileColor" content="#1d9bf6" />
    <meta
      name="msapplication-TileImage"
      content="https://www.bayfay.com/icons/images/mstile-150x150.png"
    />
    <link
      rel="icon"
      type="image/x-icon"
      id="image/x-icon21"
      href="https://www.bayfay.com/icons/images/favicon-16x16.ico">
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="https://www.bayfay.com/icons/images/favicon-32x32.ico">
    <link
      rel="icon"
      type="image/png"
      href="https://www.bayfay.com/icons/images/favicon-96x96.png">
    <link
      rel="apple-touch-icon-precomposed"
      sizes="72x72"
      href="https://www.bayfay.com/icons/images/apple-touch-icon-72x72.png">
    <%for (var i = 0; i < cssFiles.length; i++) { %>
    <link href="/static/css/<%= cssFiles[i] %>" rel="stylesheet">
    <%} %>
    <style>
      /* Keeps the SEO shell out of the way visually without removing it from
         the DOM (display:none is ignored by some crawlers/renderers) */
      #seo-shell {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <noscript>You need to enable JavaScript to run this app.</noscript>

    <!-- Static SEO content: always present in the raw HTML response,
         independent of React mounting or any API call finishing.
         Fixes: missing H1, missing headings, "page is a dead end / no
         internal links", 0-word-count errors reported by SEO crawlers. -->
    <div id="seo-shell">
      <h1><%= title %></h1>
      <p><%= description %></p>
      <p>BayFay connects you with restaurants, grocery stores, meat shops and everyday essentials near your location. Browse nearby shops, place your order online, and get it delivered to your doorstep quickly and reliably. From pizzas and burgers to biryani and fresh groceries, BayFay makes home delivery simple across cities in India.</p>
      <nav aria-label="Site">
        <a href="/home">Home</a>
        <a href="/about-us">About Us</a>
        <a href="/faq">FAQ</a>
        <a href="/help">Help</a>
        <a href="/terms">Terms of Use</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/cancellation">Cancellation &amp; Refund</a>
        <a href="/partner">Partner With Us</a>
        <a href="/merchant-help">Merchant Help</a>
        <a href="/merchant-policy">Merchant Policy</a>
      </nav>
    </div>

    <div id="root"></div>
